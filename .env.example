# Configuración del backend de NexBite.
# Copia este archivo como .env y completa los valores antes de iniciar el servidor.
# Los campos vacíos deben rellenarse con valores propios; no son credenciales válidas.

PORT=4000

# PostgreSQL: la base de datos debe tener el esquema inicial del proyecto.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurantes_ai
DB_USER=
DB_PASSWORD=

# Firma de sesiones. Utiliza un valor aleatorio largo y exclusivo de tu entorno.
JWT_SECRET=

# Stripe: clave secreta de pruebas, de la misma cuenta que la clave publicable del frontend.
STRIPE_SECRET_KEY=

# Correo: Brevo por HTTPS en Render gratuito; SMTP de Gmail para desarrollo local.
# Si EMAIL_PROVIDER queda vacío, se usa Brevo cuando hay BREVO_API_KEY; si no, SMTP.
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=
FRONTEND_URL=http://localhost:5173

# Google OAuth: si utilizas acceso con Google, debe coincidir con Auth.jsx.
GOOGLE_CLIENT_ID=

# Proveedor de direcciones; también puede apuntar a una instancia Photon propia.
PHOTON_URL=https://photon.komoot.io
